module random
implicit none
save

REAL*8      :: GSET
INTEGER     :: ISET=0

contains

FUNCTION GASDEV()

  IMPLICIT NONE

  REAL*8 RAN1,GASDEV,V1,V2,FAC,RR
  INTEGER J

    IF (ISET.EQ.0) THEN
1     call random_number(ran1) ! built in fortran 90 random number function
      V1=2.*RAN1-1.
      call random_number(ran1) ! built in fortran 90 random number function
      V2=2.*RAN1-1.
      RR=V1**2+V2**2
      IF(RR.GE.1.)GO TO 1
      FAC=SQRT(-2.*LOG(RR)/RR)
      GSET=V1*FAC
      GASDEV=V2*FAC
      ISET=1
    ELSE
      GASDEV=GSET
      ISET=0
    ENDIF

  END FUNCTION GASDEV

end module random
