
obj: $(OBJECTS) 

full: $(FICHIERS)
	-if [ "*.f" != "`echo *.f`" ] ; \
	then \
	cat *.f  > $(COMPILE) ;\
	fi ; \
	if [ "*.f90" != "`echo *.f90`" ] ; \
	then \
	cat *.f90  >> $(COMPILE)90.f90 ;\
	fi

genlib: $(OBJECTS)
	$(AR) rv $(MALIB) $(OBJECTS)

#-*-Makefile-*- 
#
OMP = -openmp 
MPI = -mpi 

FC = $(RCOMPIL) -arch $(ARCH) -abi $(ABI)  -defines "=$(DEFINE)" $(DEBUG) -optf="$(FFLAGS)" -bindir $(LCLPO) $(COMPF) $(FCOMPF) -includes $(INCLUDES) -src
 
FTNC = $(RCOMPIL) -arch $(ARCH) -abi $(ABI)  -defines "=$(DEFINE)" -optf="$(FFLAGS) $(CPPFLAGS)" -P $(COMPF) $(FCOMPF) $(INCLUDES) -src

#
MALIB = malib_$(BASE_ARCH)$(ABI).a
ABS= 3dvar_p7.abs$(ABSTAG)
AR      = r.ar -arch $(BASE_ARCH)
#


envar:  $(OBJECTS)
	-if [ -f "`echo '$(MALIB)' | sed 's/ .*//g'`" ] ;\
	then \
	mkdir $(BIG_TMPDIR)/malib$(BASE_ARCH)$(ABI) ;\
	cp *.o $(BIG_TMPDIR)/malib$(BASE_ARCH)$(ABI) 2>/dev/null ;\
	set $(MALIB) ;\
	REV_LIBS="$$1" ;\
	shift ;\
	while [ $$# -gt 0 ] ;\
	do \
	REV_LIBS="$$1 $${REV_LIBS}" ;\
	shift; \
	done ;\
	for i in $${REV_LIBS} ;\
	do \
	$(AR) xv $$i ;\
	done ;\
	ICI=$(PWD) ;\
	cd $(BIG_TMPDIR)/malib$(BASE_ARCH)$(ABI)/ ;\
	cp *.o $$ICI/. 2>/dev/null ;\
	cd $$ICI ;\
	fi ;\
	if [ "*.o" != "`echo *.o`" ] ; \
	then \
	MES_POINT_O="-obj *.o" ;\
	else \
	MES_POINT_O="" ;\
	fi ;\
        $(RBUILD) -obj $${MES_POINT_O} $(SUBOBJS) -main  cnt0 $(DEBUG) -opt "=$(LFLAGS)" \
          -o $(ABS) -libsys $(LIBSYS) -libappl $(LIBAPPL) -librmn $(LIBRMN) \
             $(OMP) $(MPI) -libpath $(LIBPATH);\
	if [ -f "`echo '$(MALIB)' | sed 's/ .*//g'`" ] ;\
	then \
	mv $(BIG_TMPDIR)/malib$(BASE_ARCH)$(ABI)/*.o ./ 2>/dev/null ;\
	rmdir $(BIG_TMPDIR)/malib$(BASE_ARCH)$(ABI) ;\
	fi ;\
	rm -f $(ABS)_*.f

envar_nompi:
	$(MAKE) envar LIBMPI="$(MPI_STUBS)"  MPI="" ABSTAG=_NOMPI 

