#!/bin/bash

set -euo pipefail

MIDAS_REPO_DIR="${MIDAS_SOURCE_DIR:-$(dirname "$(readlink -f "$0")")}"
cd $MIDAS_REPO_DIR

function print_usage {
    set -euo pipefail

    echo "${0}: [--abbrev=<n>] [<commit-ish>...]"
    echo "       --abbrev=<n>"
    echo "           Instead of using the default 7 hexadecimal digits as the"
    echo "           abbreviated object name, use <n> digits, or as many digits as"
    echo "           needed to form a unique object name. An <n> of 0 will suppress"
    echo "           long format, only showing the closest tag."
    echo "       -h|-help|--help:"
    echo "           show this help"
} ## End of 'function print_usage'

gitobject=
git_describe_options=

add_git_describe_options() {
    if [[ -n "${git_describe_options}" ]]; then
        git_describe_options="${git_describe_options} ${*}"
    else
        git_describe_options=${*}
    fi
} ## End of 'add_git_describe_options'


if [ $# -gt 0 ]; then
    while [[ $# > 0 ]]; do
        arg=${1}

        if [[ "${arg}" = --abbrev=* ]]; then
            add_git_describe_options ${arg}
        elif [[ "${arg}" = -h || "${arg}" = -help || "${arg}" = --help ]]; then
            print_usage
            exit 1
        elif [[ "${arg}" = -* ]]; then
            echo "$0: This option '${arg}' is not allowed" >&2
            echo
            print_usage
            exit 1
        elif [[ -n "${gitobject}" ]]; then
            echo "$0: You cannot provide several <commit-ish>..." >&2
            echo "     '${gitobject}' and '${arg}' was given" >&2
            echo
            print_usage
            exit 1
        else
            gitobject=${arg}
        fi

        shift
    done ## End of 'while [[ $# > 0 ]]'
    #echo "after while gitobject='${gitobject}'"
fi ## End of 'else' associated to 'if [ $# -gt 0 ]'

## 'git describe' accepts '--dirty' option only if it called without any '<commit-ish>...'
if [[ -z "${gitobject}" ]]; then
    add_git_describe_options --dirty=_M
fi

status=0
most_recent_tag_reachable=$(git tag --merged ${gitobject} | grep -E '^v_[0-9]+\.[0-9]+\.[0-9]+' | sort -V | tail -n 1) || status=1
if [ "${status}" -eq 0 ]; then
    git describe ${git_describe_options} --match ${most_recent_tag_reachable} ${gitobject} || status=1
fi

## If one of the above two command fails, we try on one of the PPPs.
if [ "${status}" -ne 0 ]; then
    toplevel=$(git rev-parse --show-toplevel)
    suite=${toplevel}/maestro/suites/midas_system_tests
    if [ ! -f ${suite}/resources/resources.def ]; then
        ## Run this command as a script since we only need the file
        ## 'maestro/suites/midas_system_tests/resources/resources.def' to
        ## be generated.
        ${toplevel}/src/config.dot.sh --build ${toplevel}/compiledir/midas_bld_resources --no-cd-build --no-show-instructions
    fi
    . ${suite}/set_machine_list.dot ${suite}

    ssh ${MACHINE_PPP} "cd ${toplevel}; most_recent_tag_reachable=\$(git tag --merged ${gitobject} | grep -E '^v_[0-9]+\.[0-9]+\.[0-9]+' | sort -V | tail -n 1); git describe ${git_describe_options} --match \${most_recent_tag_reachable}"  || echo unkown revision
fi
