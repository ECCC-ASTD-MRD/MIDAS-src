#!/bin/bash

set -euo pipefail

if [ $# -gt 1 ]; then
    echo "$0: Cannot give more than 1 argument which would be a git object.  You gave '${*}'." >&2
    exit 1
fi

if [ $# -eq 1 ]; then
    gitobject=${1}
else
    gitobject=
fi

status=0
most_recent_tag_reachable=$(git tag --merged ${gitobject} | grep -E '^v_[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1) || status=1
if [ "${status}" -eq 0 ]; then
    git describe --dirty='_M' --match ${most_recent_tag_reachable} ${gitobject} || status=1
fi

## If one of the above two command fails, we try on one of the PPPs.
if [ "${status}" -ne 0 ]; then
    toplevel=$(git rev-parse --show-toplevel)
    ${toplevel}/set_resources_def.sh
    suite=${toplevel}/maestro/suites/midas_system_tests
    . ${suite}/set_machine_list.dot ${suite}

    ssh ${MACHINE_PPP} "cd ${toplevel}; most_recent_tag_reachable=\$(git tag --merged ${gitobject} | grep -E '^v_[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1); git describe --dirty='_M' --match \${most_recent_tag_reachable}"  || echo unkown revision
fi
