build_ssm_package() {
    set -e

    typeset -r lib=${1}
    typeset -r pkgname=${2}
    typeset -r ssmpkg_destination=${3}
    typeset -r workdir=${4}

    mkdir -p ${workdir}/${pkgname}/.ssm.d
    say "Building the SSM control file"
    build_control_file ${lib} > ${workdir}/${pkgname}/.ssm.d/control.json

    say "Building the SSM tarball in ${__build_ssmpkg_dir__}"

    cd ${workdir}
    tar cvfzh ${pkgname}.ssm ${pkgname}

    cp ${pkgname}.ssm ${ssmpkg_destination}

    say "The SSM package '${pkgname}.ssm' is available in directory ${ssmpkg_destination}"
} ## End of function 'build_ssm_package'

INSTALL_DIR=${workdir}/${pkgname}/bin
mkdir -p ${INSTALL_DIR}

for lib in ${libs}; do
    download_lib ${lib} ${workdir}
    build_lib    ${lib} ${workdir}
    build_ssm_package ${lib} ${pkgname} ${ssmpkgdestination} ${workdir}
done

cd
rm -r ${workdir}
