            labelPosition=self.output.find('-'+label+'.')
            self.assertTrue(labelPosition != -1)

    def test_onlyLabelInOutput(self):
        lines = self.output.splitlines()
        for line in lines[2:]:
            elem = line[:40].rstrip('.').lstrip('-')
            self.assertTrue(elem in self.labels)

class test_reference(unittest.TestCase):

    def setUp(self):
        listing = list()
        listing.append('''oe-00000-00000: TMG: PE=   0 ,LABEL=--Main.................................. ,COUNT=1 ,TIME=           47.268173 seconds, AVG=           47.268173 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----A................................... ,COUNT=340 ,TIME=           29.237750 seconds, AVG=            0.085993 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----B................................... ,COUNT=85 ,TIME=            3.216157 seconds, AVG=            0.026072 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----C................................... ,COUNT=85 ,TIME=           13.351298 seconds, AVG=            0.157074 seconds
        oe-00000-00001: TMG: PE=   1 ,LABEL=----D................................... ,COUNT=656 ,TIME=            7.071841 seconds, AVG=            0.010780 seconds''')
        listing.append('''oe-00000-00000: TMG: PE=   0 ,LABEL=--Main.................................. ,COUNT=1 ,TIME=           47.268173 seconds, AVG=           47.268173 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----B................................... ,COUNT=85 ,TIME=            3.216157 seconds, AVG=            0.026072 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----C................................... ,COUNT=85 ,TIME=           13.351298 seconds, AVG=            0.157074 seconds
        oe-00000-00001: TMG: PE=   1 ,LABEL=----E................................... ,COUNT=741 ,TIME=            4.492428 seconds, AVG=            0.006063 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----A................................... ,COUNT=340 ,TIME=           29.237750 seconds, AVG=            0.085993 seconds''')

        lines = list()
        lines.append(listing[0].splitlines())
        lines.append(listing[1].splitlines())

        self.labels = dict()
        self.labels['1'] = listLabels(lines[0])
        self.labels['2'] = listLabels(lines[1])
        self.labels['1r2o1'] = listLabels(lines[0], linesRef=lines[1], order=1)
        self.labels['2r1o2'] = listLabels(lines[1], linesRef=lines[0], order=2)

        timings = dict()
        timings['1']=getMeanMaxMin(lines[0], self.labels['1'])
        timings['2']=getMeanMaxMin(lines[1], self.labels['2'])
        timings['1r2o1']=getMeanMaxMin(lines[0], self.labels['1r2o1'])
        timings['2r1o1']=getMeanMaxMin(lines[1], self.labels['2r1o2'])

        self.output = dict()
        self.output['1'] = outputTMG(self.labels['1'], timings['1'])
        self.output['2'] = outputTMG(self.labels['2'], timings['2'])
        self.output['1r2o1'] = outputTMG(self.labels['1r2o1'], timings['1r2o1'])
        self.output['2r1o2'] = outputTMG(self.labels['2r1o2'], timings['2r1o1'])

        self.expected = dict()
        self.expected['1']=('Main', 'A', 'B', 'C', 'D')
        self.expected['2']=('Main', 'B', 'C', 'A', 'E')
        self.expected['12ref1']=('Main', 'A', 'B', 'C', 'D', 'E')


    def test_labelOrder_single(self):
        for key in ('1', '2'):
            lines = self.output[key].splitlines()
            for i, line in enumerate(lines[2:]):
                elem = line[:40].rstrip('.').lstrip('-')
                self.assertTrue(elem == self.expected[key][i])

    def test_labelOrder_withRef(self):
        for key in ('1r2o1', '2r1o2'):
            lines = self.output[key].splitlines()
            for i, line in enumerate(lines[2:]):
                elem = line[:40].rstrip('.').lstrip('-')
                self.assertTrue(elem == self.expected['12ref1'][i])

    def test_allLabelInOutput(self):
        allLabels = set(self.labels['1r2o1'])
        allLabels.union(self.labels['2r1o2'])
        check = True
        for label in allLabels:
            if self.output['2r1o2'].find(label) == -1 or self.output['2r1o2'].find(label) == -1:
                check = False
        self.assertTrue(check)


class test_compare(unittest.TestCase):

    def setUp(self):
        listing = list()
        listing.append('''oe-00000-00000: TMG: PE=   0 ,LABEL=--Main.................................. ,COUNT=1 ,TIME=           48.300000 seconds, AVG=           48.300000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Big................................. ,COUNT=340 ,TIME=           30.000000 seconds, AVG=            0.087000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Small............................... ,COUNT=85 ,TIME=            2.800000 seconds, AVG=            0.046000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Negligeable......................... ,COUNT=3 ,TIME=            0.500000 seconds, AVG=            0.160000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----InBetween........................... ,COUNT=85 ,TIME=           15.000000 seconds, AVG=            0.160000 seconds''')
        listing.append('''oe-00000-00000: TMG: PE=   0 ,LABEL=--Main.................................. ,COUNT=1 ,TIME=           47.250000 seconds, AVG=           47.250000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Big................................. ,COUNT=340 ,TIME=           29.300000 seconds, AVG=            0.085000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Small............................... ,COUNT=85 ,TIME=            3.100000 seconds, AVG=            0.057000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Negligeable......................... ,COUNT=3 ,TIME=            0.450000 seconds, AVG=            0.155000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----InBetween........................... ,COUNT=85 ,TIME=           14.400000 seconds, AVG=            0.143000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----OnlyInThisOne....................... ,COUNT=3  ,TIME=            6.000000 seconds, AVG=            6.000000 seconds''')
        lines = list()
        lines.append(listing[0].splitlines())
        lines.append(listing[1].splitlines())

        self.labels = listLabels(lines[0], linesRef=lines[1], order=1)
        self.timings = list()
        for i in range(2):
            j = 1 if i == 0 else 0
            self.timings.append(getMeanMaxMin(lines[i], self.labels))

        self.diff = computeDiffTMG(self.labels, self.timings)

    def test_checkDifference(self):
        differences= self.diff[0]
        for i, listOfDiff in enumerate(differences):
            for j, value in enumerate(listOfDiff):
                self.assertAlmostEqual(value, self.timings[0][0][i][j]-self.timings[1][0][i][j], 5)


class test_timingStats(unittest.TestCase):

    def setUp(self):
        listing = '''oe-00000-00000: TMG: PE=   0 ,LABEL=--Main.................................. ,COUNT=1 ,TIME=           48.300000 seconds, AVG=           48.300000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Big................................. ,COUNT=340 ,TIME=           30.000000 seconds, AVG=            0.087000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Small............................... ,COUNT=85 ,TIME=            2.800000 seconds, AVG=            0.046000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Negligeable......................... ,COUNT=3 ,TIME=            0.500000 seconds, AVG=            0.160000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----DifferentCount...................... ,COUNT=75 ,TIME=           15.000000 seconds, AVG=            0.160000 seconds
        oe-00000-00001: TMG: PE=   0 ,LABEL=----Big................................. ,COUNT=340 ,TIME=           29.300000 seconds, AVG=            0.085000 seconds
        oe-00000-00001: TMG: PE=   0 ,LABEL=----Small............................... ,COUNT=85 ,TIME=            3.100000 seconds, AVG=            0.057000 seconds
        oe-00000-00001: TMG: PE=   0 ,LABEL=----Negligeable......................... ,COUNT=3 ,TIME=            0.450000 seconds, AVG=            0.155000 seconds
        oe-00000-00001: TMG: PE=   0 ,LABEL=----DifferentCount...................... ,COUNT=85 ,TIME=           14.400000 seconds, AVG=            0.143000 seconds
        oe-00000-00001: TMG: PE=   0 ,LABEL=----OnlyOnce............................ ,COUNT=3  ,TIME=            6.000000 seconds, AVG=            6.000000 seconds
        oe-00000-00002: TMG: PE=   0 ,LABEL=----Small............................... ,COUNT=85 ,TIME=            3.000000 seconds, AVG=            0.052000 seconds
        oe-00000-00002: TMG: PE=   0 ,LABEL=----Negligeable......................... ,COUNT=3 ,TIME=            0.510000 seconds, AVG=            0.163000 seconds
        oe-00000-00002: TMG: PE=   0 ,LABEL=----DifferentCount...................... ,COUNT=95 ,TIME=           15.300000 seconds, AVG=            0.160000 seconds'''
        lines = listing.splitlines()
        self.labels = listLabels(lines, minTMG=0.0)
        # add a label from a reference which is not in the lines
        self.labels.append('----NotPresent..........................')
        self.timings = getMeanMaxMin(lines, self.labels)
        self.expected = dict()
        self.expected['time'] = {   '--Main..................................': {'mean':48.3, 'max':48.3, 'min':48.3},
                                    '----Big.................................': {'mean':29.65, 'max':30., 'min':29.3},
                                    '----Small...............................': {'mean':2.966666666666667, 'max':3.1, 'min':2.8},
                                    '----Negligeable.........................': {'mean':0.48666666666666664, 'max':0.51, 'min':0.45},
                                    '----DifferentCount......................': {'mean':14.9, 'max':15.3, 'min':14.4},
                                    '----OnlyOnce............................': {'mean':6., 'max':6., 'min':6.},
                                    '----NotPresent..........................': {'mean':0., 'max':0., 'min':0.}
                                    }
        self.expected['count'] = {  '--Main..................................': {'mean':1, 'max':1, 'min':1},
                                    '----Big.................................': {'mean':340, 'max':340, 'min':340},
                                    '----Small...............................': {'mean':85, 'max':85, 'min':85},
                                    '----Negligeable.........................': {'mean':3, 'max':3, 'min':3},
                                    '----DifferentCount......................': {'mean':85, 'max':95, 'min':75},
                                    '----OnlyOnce............................': {'mean':3, 'max':3, 'min':3},
                                    '----NotPresent..........................': {'mean':0., 'max':0., 'min':0.}
                                    }

    def test_time(self):
        for i, stat in enumerate(('mean', 'max', 'min')):
            value = dict()
            for j, label in enumerate(self.labels):
                value[stat] = self.timings[0][i][j]
                self.assertAlmostEqual(value[stat], self.expected['time'][label][stat], 3)

    def test_count(self):
        for i, stat in enumerate(('mean', 'max', 'min')):
            value = dict()
            for j, label in enumerate(self.labels):
                value[stat] = self.timings[1][i][j]
                self.assertAlmostEqual(value[stat], self.expected['count'][label][stat], 3)

#==== Main ===================================================================

if __name__ == "__main__":
    if args.unittest:
        unittest.main(argv=[parser.prog], verbosity=2)
    else:
        if args.title != None:
            print(f"{args.title}")
        else:
            print(f"Processing {inputUnit.name}")

        if refUnit:
            if args.title_reference != None:
                print(f"{args.title_reference} (reference)")
            else:
                print(f"Reference file supplied: {args.reference}")
            if exptOrder == "2":
                print("  - Reference file used first for constructing label list")
            else:
                print("  - Main file used first for constructing label list")

        if args.diff:
            if refUnit == None:
                raise ValueError(f"Reference listing must be provided with `-r|--diff`")
            compareTMG(inputUnit, refUnit)
        else:
            printTMG(inputUnit, refUnit)
