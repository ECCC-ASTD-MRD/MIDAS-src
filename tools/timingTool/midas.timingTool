        labelList = listLabels(allLines)
        timings = getMeanMaxMin(allLines, labelList)
        self.output = outputTMG(labelList, timings)

    def test_labelPresence(self):
        for label in self.labels:
            labelPosition=self.output.find('-'+label+'.')
            self.assertTrue(labelPosition != -1)

    def test_onlyLabelPresence(self):
        lines = self.output.splitlines()
        for line in lines[2:]:
            elem = line[:40].rstrip('.').lstrip('-')
            self.assertTrue(elem in self.labels)

class test_order(unittest.TestCase):

    def setUp(self):
        listing = list()
        listing.append('''oe-00000-00000: TMG: PE=   0 ,LABEL=--Main.................................. ,COUNT=1 ,TIME=           47.268173 seconds, AVG=           47.268173 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----A................................... ,COUNT=340 ,TIME=           29.237750 seconds, AVG=            0.085993 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----B................................... ,COUNT=85 ,TIME=            3.216157 seconds, AVG=            0.026072 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----C................................... ,COUNT=85 ,TIME=           13.351298 seconds, AVG=            0.157074 seconds''')
        listing.append('''oe-00000-00000: TMG: PE=   0 ,LABEL=--Main.................................. ,COUNT=1 ,TIME=           47.268173 seconds, AVG=           47.268173 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----B................................... ,COUNT=85 ,TIME=            3.216157 seconds, AVG=            0.026072 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----C................................... ,COUNT=85 ,TIME=           13.351298 seconds, AVG=            0.157074 seconds
        oe-00000-00001: TMG: PE=   1 ,LABEL=----D................................... ,COUNT=741 ,TIME=            4.492428 seconds, AVG=            0.006063 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----A................................... ,COUNT=340 ,TIME=           29.237750 seconds, AVG=            0.085993 seconds''')

        allLines = list()
        allLines.append(listing[0].splitlines())
        allLines.append(listing[1].splitlines())

        labels = dict()
        labels['1'] = listLabels(allLines[0])
        labels['2'] = listLabels(allLines[1])
        labels['1r2o1'] = listLabels(allLines[0], allLinesRef=allLines[1], order=1)
        labels['2r1o2'] = listLabels(allLines[1], allLinesRef=allLines[0], order=2)

        timings = list()
        timings.append(getMeanMaxMin(allLines[0], labels['1']))
        timings.append(getMeanMaxMin(allLines[1], labels['2']))

        self.output = dict()
        self.output['1'] = outputTMG(labels['1'], timings[0])
        self.output['2'] = outputTMG(labels['2'], timings[1])
        self.output['1r2o1'] = outputTMG(labels['1r2o1'], timings[1])
        self.output['2r1o2'] = outputTMG(labels['2r1o2'], timings[1])

        self.expected = dict()
        self.expected['1']=('Main', 'A', 'B', 'C')
        self.expected['2']=('Main', 'B', 'C', 'D', 'A')
        self.expected['12ref1']=('Main', 'A', 'B', 'C', 'D')


    def test_labelOrder_single(self):
        for key in ('1', '2'):
            lines = self.output[key].splitlines()
            for i, line in enumerate(lines[2:]):
                elem = line[:40].rstrip('.').lstrip('-')
                self.assertTrue(elem == self.expected[key][i])

    def test_labelOrder_withRef1(self):
        for key in ('1r2o1', '2r1o2'):
            lines = self.output[key].splitlines()
            for i, line in enumerate(lines[2:]):
                elem = line[:40].rstrip('.').lstrip('-')
                self.assertTrue(elem == self.expected['12ref1'][i])

class test_compare(unittest.TestCase):

    def setUp(self):
        listing = list()
        listing.append('''oe-00000-00000: TMG: PE=   0 ,LABEL=--Main.................................. ,COUNT=1 ,TIME=           48.300000 seconds, AVG=           48.300000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Big................................. ,COUNT=340 ,TIME=           30.000000 seconds, AVG=            0.087000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Small............................... ,COUNT=85 ,TIME=            2.800000 seconds, AVG=            0.046000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Negligeable......................... ,COUNT=3 ,TIME=            0.500000 seconds, AVG=            0.160000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----InBetween........................... ,COUNT=85 ,TIME=           15.000000 seconds, AVG=            0.160000 seconds''')
        listing.append('''oe-00000-00000: TMG: PE=   0 ,LABEL=--Main.................................. ,COUNT=1 ,TIME=           47.250000 seconds, AVG=           47.250000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Big................................. ,COUNT=340 ,TIME=           29.300000 seconds, AVG=            0.085000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Small............................... ,COUNT=85 ,TIME=            3.100000 seconds, AVG=            0.057000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Negligeable......................... ,COUNT=3 ,TIME=            0.450000 seconds, AVG=            0.155000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----InBetween........................... ,COUNT=85 ,TIME=           14.400000 seconds, AVG=            0.143000 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----OnlyInThisOne....................... ,COUNT=3  ,TIME=            6.000000 seconds, AVG=            6.000000 seconds''')
        allLines = list()
        allLines.append(listing[0].splitlines())
        allLines.append(listing[1].splitlines())

        self.labels = listLabels(allLines[0], allLinesRef=allLines[1], order=1)
        self.timings = list()
        for i in range(2):
            j = 1 if i == 0 else 0
            self.timings.append(getMeanMaxMin(allLines[i], self.labels))

        self.diff = computeDiffTMG(self.labels, self.timings)

    def test_checkDifference(self):
        differences= self.diff[0]
        for i, listOfDiff in enumerate(differences):
            for j, value in enumerate(listOfDiff):
                self.assertAlmostEqual(value, self.timings[0][0][i][j]-self.timings[1][0][i][j], 5)



if __name__ == "__main__":
    if args.unittest:
        unittest.main(argv=[parser.prog], verbosity=2)
    else:
        print(f"Processing {inputUnit.name}")

        if filename2:
            print(f"Reference file supplied: {filename2}")
            if exptOrder == "2":
                print("Reference file used first for constructing label list")
            else:
                print("Main file used first for constructing label list")

            try:
                refUnit = open(filename2, 'r')
            except:
                print(f"The reference file '{filename2}' does not exist!")
                exit(1)
        else:
            refUnit = None

        if args.diff:
            if refUnit == None:
                raise ValueError(f"Reference listing must be provided with `-r|--diff`")
            compareTMG(inputUnit, refUnit)
        else:
            printTMG(inputUnit, refUnit)
