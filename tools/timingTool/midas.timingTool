        oe-00000-00000: TMG: PE=   0 ,LABEL=----InterpolateWeights.................. ,COUNT=85 ,TIME=            2.216157 seconds, AVG=            0.026072 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----Barr................................ ,COUNT=3 ,TIME=            0.502958 seconds, AVG=            0.167653 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----GetGlobalTags....................... ,COUNT=1 ,TIME=            0.012784 seconds, AVG=            0.012784 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----ApplyWeights........................ ,COUNT=85 ,TIME=           13.351298 seconds, AVG=            0.157074 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=------ApplyWeightsMember................ ,COUNT=52954 ,TIME=           12.892664 seconds, AVG=            0.000243 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----CommWeights-signals................. ,COUNT=85 ,TIME=           29.035015 seconds, AVG=            0.341588 seconds
        oe-00000-00000: TMG: PE=   0 ,LABEL=----CommWeights-waitSend................ ,COUNT=85 ,TIME=            0.000028 seconds, AVG=            0.000000 seconds
