        oe-00000-00001: TMG: PE=   1 ,LABEL=----GetGlobalTags....................... ,COUNT=1 ,TIME=            0.013603 seconds, AVG=            0.013603 seconds
        oe-00000-00001: TMG: PE=   1 ,LABEL=----ApplyWeights........................ ,COUNT=85 ,TIME=           13.299899 seconds, AVG=            0.156469 seconds
        oe-00000-00001: TMG: PE=   1 ,LABEL=------ApplyWeightsMember................ ,COUNT=52954 ,TIME=           12.826459 seconds, AVG=            0.000242 seconds
        oe-00000-00001: TMG: PE=   1 ,LABEL=----CommWeights-signals................. ,COUNT=741 ,TIME=            4.492428 seconds, AVG=            0.006063 seconds
        oe-00000-00001: TMG: PE=   1 ,LABEL=----CommWeights-waitSend................ ,COUNT=85 ,TIME=            0.007523 seconds, AVG=            0.000089 seconds
        oe-00000-00001: TMG: PE=   1 ,LABEL=----CommWeights-waitRecv................ ,COUNT=85 ,TIME=            0.033655 seconds, AVG=            0.000396 seconds
