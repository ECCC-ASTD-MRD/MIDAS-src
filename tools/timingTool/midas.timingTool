#!/usr/bin/env python
# -*- coding: utf-8 -*-

import sys
import argparse
import unittest
import gzip

#==== Command line interface =================================================

parser = argparse.ArgumentParser()
parser.add_argument("listing", nargs='?', type=argparse.FileType('rb'), default=sys.stdin,
                    help="input listing to be parsed for timings, omitting this argument, the script will read directly from stdin")
parser.add_argument("-r", "--reference", help="reference listing to ensure common list of labels")
parser.add_argument("-1", "--title", help="Replacement title for input")
parser.add_argument("-2", "--title-reference", help="Replacement title for reference")
parser.add_argument("-d", "--diff", help="compare input listing with the reference",action="store_true", default=False)
parser.add_argument("-n", "--nocount", help="Do not show call count",action="store_false", default=True)
parser.add_argument("-o", "--order", help="order to construct the list of labels", type=int, choices=[1, 2], default=1)
parser.add_argument("-l", "--limit", help="minimum timing threshold", type=float, default=3.0)
parser.add_argument("-u", "--unittest", help="Run the unit tests",action="store_true", default=False)
args = parser.parse_args()


#==== Input processing =======================================================
minimumTimingLimit=args.limit
exptOrder=args.order
showCount=args.nocount

# Define the magic number for gzip files
GZIP_MAGIC = b'\x1f\x8b'

def is_gzipped(file):
    """ Check if the input stream is gzipped by reading the first two bytes. """
    first_two_bytes = file.read(2)  # Read the first two bytes
    file.seek(0)  # Reset file pointer to the beginning
    return first_two_bytes == GZIP_MAGIC


input_source = args.listing # a binary file
# argparse will either open the file passed or feed in stdin
# note that it's not the filename that is passed, but the open file object _io.TextIOWrapper

# Determine if the input is gzipped
if is_gzipped(input_source):
    if input_source is sys.stdin.buffer:
        inputUnit = gzip.open(sys.stdin.buffer, 'rt')  # Open stdin as a gzipped stream
    else:
        inputUnit = gzip.open(input_source.name, 'rt')  # Open file as a gzipped stream
else:
    # If the input is not gzipped, read it as plain text
    if input_source is sys.stdin.buffer:
        inputUnit = sys.stdin  # Use stdin directly if not gzipped
    else:
        inputUnit = open(input_source.name, 'r')  # Open as a plain text file



# this allows the user to specify a reference listing - timing information
# will not be generated from this file, but it will be used to ensure a
# common list (and order) of the labels to facilitate an xxdiff of files
# from running the script twice, once for each listing file
refUnit = None
if args.reference:
    try:
        with gzip.open(args.reference, 'rb') as file:
            file.read(1)    #  Reading one byte forces a header check
            ref_gzipped = True
    except (OSError, gzip.BadGzipFile):
        ref_gzipped = False

    if ref_gzipped:
        refUnit = gzip.open(args.reference, 'rb')
    else:
        refUnit = open(args.reference, 'r')



#==== Top-level functions ====================================================

def printTMG(fileObj, fileObjRef = None):
    '''Top-level function for printing timings'''
    lines = extractLines(fileObj)
    if fileObjRef != None:
        linesRef = extractLines(fileObjRef)
    else:
        linesRef = None

    labelList = listLabels( lines, linesRef=linesRef, order=exptOrder,
                            minTMG=minimumTimingLimit)
    timings = getMeanMaxMin(lines, labelList)

    print()
    print(outputTMG(labelList, timings, showCount=showCount))

def compareTMG(fileObj1, fileObj2):
    '''Top-level function for comparing timings'''
    fileObjList = (fileObj1, fileObj2)

    lines = list()
    for i in range(2):
        lines.append(extractLines(fileObjList[i]))

    labels = listLabels(lines[0], linesRef=lines[1], order=1,
                        minTMG=minimumTimingLimit)
    timings = list()
    for i in range(2):
        timings.append(getMeanMaxMin(lines[i], labels))

    diffTMG = computeDiffTMG(labels, timings)

    print()
    print(outputDiffTMG(labels, diffTMG, timings, showCount=showCount))


#==== Output processing ======================================================

def outputTMG( labelList, timings, showCount=False):
    '''Formatting function for timings'''
    (meanTimingList, maxTimingList, minTimingList) = timings[0]
    (meanCountList, maxCountList, minCountList) = timings[1]
    string = ''
    string +=   '{:40}'.format('LABEL') +'{:^10}'.format('meanTime') + '{:^8}'.format('maxTime') + \
                '{:^8}'.format('minTime')
    if showCount:
        string+='{:^10}'.format('meanCount') + '{:^10}'.format('maxCount') + \
                '{:^10}'.format('minCount') + '\n'
    else:
        string+='\n'

    string +=   '{:40}'.format('='*5) + '{:^10}'.format('='*9) + '{:^8}'.format('='*7) +\
                '{:^8}'.format('='*7)
    if showCount:
        string+='{:^10}'.format('='*9) + '{:^10}'.format('='*9) + \
                '{:^10}'.format('='*9) + '\n'
    else:
        string+='\n'

    for listIndex, label in enumerate(labelList):
        string +=   '{:40}'.format(labelList[listIndex]) + \
                    '{:9.2f}'.format(meanTimingList[listIndex]) + \
                    '{:8.2f}'.format(maxTimingList[listIndex]) + \
                    '{:8.2f}'.format(minTimingList[listIndex])
        if showCount:
            string +=   '{:10d}'.format(round(meanCountList[listIndex])) + \
                        '{:10d}'.format(maxCountList[listIndex]) + \
                        '{:10d}'.format(minCountList[listIndex]) + '\n'
        else:
            string+='\n'

    return string

def outputDiffTMG(labelList, diff, timings, showCount=False):
    '''Formatting function for timing comparisons'''
    (meanDiffTimingList, maxDiffTimingList, minDiffTimingList) = diff[0]
    (meanDiffCountList, maxDiffCountList, minDiffCountList) = diff[1]
    (meanTimingList, maxTimingList, minTimingList) = timings[0][0]
    (meanCountList, maxCountList, minCountList) = timings[0][1]
    (meanTimingListRef, maxTimingListRef, minTimingListRef) = timings[1][0]
    (meanCountListRef, maxCountListRef, minCountListRef) = timings[1][1]
    string = ''
    string +=   '{:40}'.format('LABEL') +'{:^31}'.format('meanTimeDiff') + \
                '{:^31}'.format('maxTimeDiff') + '{:^31}'.format('minTimeDiff')
    if showCount:
        string+='{:^36}'.format('meanCountDiff') + '{:^36}'.format('maxCountDiff') + \
                '{:^36}'.format('minCountDiff') + '\n'
    else:
        string+='\n'

    string +=   '{:40}'.format('='*4) + '{:^31}'.format('='*29) + \
                '{:^31}'.format('='*29) + '{:^31}'.format('='*29)
    if showCount:
        string+='{:^36}'.format('='*34) + '{:^36}'.format('='*34) + \
                '{:^36}'.format('='*34) + '\n'
    else:
        string+='\n'

    for listIndex, label in enumerate(labelList):
        string +=   '{:40}'.format(labelList[listIndex]) + \
                    '{:8.2f}'.format(meanDiffTimingList[listIndex]) + \
                    ' ({:8.2f} | {:8.2f})'.format(meanTimingList[listIndex], meanTimingListRef[listIndex]) +\
                    '{:8.2f}'.format(maxDiffTimingList[listIndex]) + \
                    ' ({:8.2f} | {:8.2f})'.format(maxTimingList[listIndex], maxTimingListRef[listIndex]) +\
                    '{:8.2f}'.format(minDiffTimingList[listIndex]) + \
                    ' ({:8.2f} | {:8.2f})'.format(minTimingList[listIndex], minTimingListRef[listIndex])
        if showCount:
            string+='{:10d}'.format(round(meanDiffCountList[listIndex])) + \
                    ' ({:10d} | {:10d})'.format(round(meanCountList[listIndex]), round(meanCountListRef[listIndex])) +\
                    '{:10d}'.format(maxDiffCountList[listIndex]) + \
                    ' ({:10d} | {:10d})'.format(maxCountList[listIndex], maxCountListRef[listIndex]) + \
                    '{:10d}'.format(minDiffCountList[listIndex]) + \
                    ' ({:10d} | {:10d})'.format(minCountList[listIndex], minCountListRef[listIndex]) + '\n'
        else:
            string+='\n'
    return string

#==== Line processing ========================================================

def extractLines(fileObj):
    lines = list()
    for line in fileObj:
        line=str(line)
        strIndex = line.find(" TMG:")
        if line.find(" TMG:") == -1 or line.find("oe-") == -1:
            continue
        lines.append(line.rstrip('\n'))
    return lines

def xLabel(line):
    return line.partition("LABEL=")[2].partition(",")[0].strip()

def xNode(line):
    return line.partition("oe-")[2].partition(":")[0]

def xTime(line):
    return float(line.partition("TIME=")[2].partition("seconds")[0].strip())

def xCount(line):
    return int(line.partition("COUNT=")[2].partition(",")[0].strip())

def orderLabels(lines):
    nodeListDict = dict()
    nodes        = list()
    for line in lines:
        label = xLabel(line)
        node  = xNode(line)

        if node not in nodeListDict:
            nodeListDict[node] = list()
            nodes.append(node)

        if label not in nodeListDict[node]:
            nodeListDict[node].append(label)

    # compute proper order
    masterList = nodeListDict[nodes.pop(0)]
    for node in nodes:
        labelList = nodeListDict[node]
        newLabels = [label for label in labelList if label not in masterList]

        while newLabels:
            label = newLabels.pop(0)

            # find neighbors of label in the current list
            pos = labelList.index(label)
            if pos > 0:
                leftNeighbor = labelList[pos - 1]
            else:
                leftNeighbor = None

            if pos < len(labelList) - 1:
                rightNeighbor = labelList[pos + 1]
            else:
                rightNeighbor = None

            # determine the position to insert the label in the master list
            if leftNeighbor and leftNeighbor in masterList:
                insertPos = masterList.index(leftNeighbor) + 1
            elif rightNeighbor and rightNeighbor in masterList:
                insertPos = masterList.index(rightNeighbor)
            else:
                insertPos = len(masterList)

            masterList.insert(insertPos, label)

            # re-check for new label after insertion
            newLabels = [label for label in labelList if label not in masterList]

    return masterList


def listLabels(lines, linesRef=None, order=1, minTMG=3.0):
    '''get unique and complete list of labels'''

    # we make sure to use copy for lines instead of reference since we'll use extend()
    if linesRef != None:
        if order == 1:
            allLines = list(lines)
            allLines.extend(linesRef)
        else:
            allLines = list(linesRef)
            allLines.extend(lines)
    else:
        allLines = list(lines)

    labels = orderLabels(allLines)

    # remove labels from the list if the max timing is less that a minimum threshold
    labelTimingList = list()
    for label in labels:

        timingList = list()
        for line in allLines:
            if label == xLabel(line):
                timing = xTime(line)
                timingList.append(timing)
        # check maximum timing
        if max(timingList) > minTMG:
            labelTimingList.append(label)
    return labelTimingList

#==== Timing stats computations ==============================================

def getMeanMaxMin(lines, labelList):
    '''get min/max/mean timing and counts for each label in labelList'''
    minTimingList = list()
    maxTimingList = list()
    meanTimingList = list()
    minCountList = list()
    maxCountList = list()
    meanCountList = list()
    timingLists = list()
    countLists = list()
    for label in labelList:
        timingList = list()
        countList = list()
        for line in lines:
            if label == xLabel(line):
                timing = xTime(line)
                count  = xCount(line)
                timingList.append(timing)
                countList.append(count)
        # timing stats
        if timingList:
            minTimingList.append(min(timingList))
            maxTimingList.append(max(timingList))
            meanTimingList.append(sum(timingList)/len(timingList))
        else:
            minTimingList.append(0.0)
            maxTimingList.append(0.0)
            meanTimingList.append(0.0)

        # count stats
        if countList:
            minCountList.append(min(countList))
            maxCountList.append(max(countList))
            meanCountList.append(sum(countList)/len(countList))
        else:
            minCountList.append(0)
            maxCountList.append(0)
            meanCountList.append(0)

        # complete info
        timingLists.append((timingList))
        countLists.append((countList))

    return ((meanTimingList, maxTimingList, minTimingList),
            (meanCountList, maxCountList, minCountList),
            timingLists, countLists)

def computeDiffTMG(labelList, timings):
    '''compute differences from timings and counts'''
    minDiffTimingList = list()
    maxDiffTimingList = list()
    meanDiffTimingList = list()
    minDiffCountList = list()
    maxDiffCountList = list()
    meanDiffCountList = list()
    (meanTimingList, maxTimingList, minTimingList) = timings[0][0]
    (meanCountList, maxCountList, minCountList) = timings[0][1]
    (meanTimingListRef, maxTimingListRef, minTimingListRef) = timings[1][0]
    (meanCountListRef, maxCountListRef, minCountListRef) = timings[1][1]
    for listIndex in range(0,len(labelList)):
        meanDiffTimingList.append(meanTimingList[listIndex]-meanTimingListRef[listIndex])
        maxDiffTimingList.append(maxTimingList[listIndex]-maxTimingListRef[listIndex])
        minDiffTimingList.append(minTimingList[listIndex]-minTimingListRef[listIndex])
        meanDiffCountList.append(meanCountList[listIndex]-meanCountListRef[listIndex])
        maxDiffCountList.append(maxCountList[listIndex]-maxCountListRef[listIndex])
        minDiffCountList.append(minCountList[listIndex]-minCountListRef[listIndex])

    return ((meanDiffTimingList, maxDiffTimingList, minDiffTimingList),
            (meanDiffCountList, maxDiffCountList, minDiffCountList))


#==== Unit Tests =============================================================

