#!/bin/bash

set -euo pipefail

description="This script prepares a working directory to launch 'midas-letkf.Abs'."

arguments=$*
eval $(cclargs  -D  "" $0 "[${description}]"                                       \
  -ensemble         "" "" "[path to ensemble directory]"                           \
  -nml              "" "" "[path to namelist file]"                                \
  -observations     "" "" "[path to observations]"                                 \
  -constants        "" "" "[path to constants]"                                    \
  -npex             "" "" "[number of MPI ranks along the X axis]"                 \
  -npey             "" "" "[number of MPI ranks along the Y axis]"                 \
  -workdir          "" "" "[output working directory]"                             \
  -splitobs         "" "" "[path to the 'midas.splitobs.Abs' program (mandatory)]" \
  -splitobs_ndigits 4  4  "[number of digits for the extension when splitting observations files (default: 4)]" \
  -dosplit        yes yes "[do the splitting of the observations, if no then assume the observations already split (default: yes)]" \
  ++ $arguments)

scriptName=${0##*/}

function say {
    printf "${scriptName}: ${1}\n"
    shift
    local say_message
    IFS=$'\n\t'
    for say_message in ${@}; do
        printf "\t${say_message}\n"
    done
} ## End of 'function say'

function die {
    IFS=$'\n\t'
    say $@ >&2
    exit 1
} ## End of 'function die'

## Check if all mandatory arguments have been given
for launch_arg in ensemble nml observations constants npex npey workdir splitobs; do
    eval launch_tmp_var="\${${launch_arg}}"
    if [ -z "${launch_tmp_var}" ]; then
        die "The argument '-${launch_arg}' must be defined"
    fi
    unset launch_tmp_var
done
unset launch_arg

if [ "${dosplit}" = yes ]; then
    if [ -z "${splitobs}" ]; then
        die "The argument '-${splitobs}' must be defined if '-dosplit' is 'yes'."
    fi
fi

function copyOrUnzip {
    if [[ $# -ne 2 && $# -ne 3 ]]; then
        die "Cannot accept other than 2 or 3 arguments.  Here: 'copyOrUnzip ${*}'"
    fi

    local copyOrUnzip_input copyOrUnzip_outputDirectory copyOrUnzip_copyCommand copyOrUnzip_orginalDirectory
    copyOrUnzip_input=${1}
    copyOrUnzip_outputDirectory=${2}
    copyOrUnzip_copyCommand=${3:-cp}
    copyOrUnzip_originalDirectory=${PWD}

    if [[ ${copyOrUnzip_outputDirectory} != . ]]; then
        mkdir ${copyOrUnzip_outputDirectory}
        cd ${copyOrUnzip_outputDirectory}
    fi

    if [[ -d "${copyOrUnzip_input}" ]]; then
        if [[ "${copyOrUnzip_copyCommand}" = cp ]]; then
            say "copyOrUnzip: Copying files from ${copyOrUnzip_input}"
            cp -rL ${copyOrUnzip_input}/* .
        elif [[ "${copyOrUnzip_copyCommand}" = ln ]]; then
            say "copyOrUnzip: Linking files from ${copyOrUnzip_input}"
            ln -s ${copyOrUnzip_input}/* .
        else
            die "The copy command '${copyOrUnzip_copyCommand}' is not allowed.  Only 'cp' and 'ln' are."
        fi
    elif [[ -f "${copyOrUnzip_input}" ]]; then
        if [[ "${copyOrUnzip_input}" = *.ca ]]; then
            say "copyOrUnzip: Extracting files from ${copyOrUnzip_input}"
            cmcarc -f ${copyOrUnzip_input} -x
        elif [[ "${copyOrUnzip_input}" = *.tar ]]; then
            say "copyOrUnzip: Extracting files from ${copyOrUnzip_input}"
            tar xf ${copyOrUnzip_input}
        elif [[ "${copyOrUnzip_input}" = *.tar.gz || "${copyOrUnzip_input}" = *.tgz ]]; then
            say "copyOrUnzip: Extracting files from ${copyOrUnzip_input}"
            tar zxf ${copyOrUnzip_input}
        else
            die "copyOrUnzip: If the first argument is a file, it must be a '.ca' file (cmcarc format), '.tar', '.tar.gz' or '.tgz' archive.\n\tGot ${copyOrUnzip_input}"
        fi
    else
        die "copyOrUnzip: The input argument '${copyOrUnzip_input}' does not exist!"
    fi

    if [[ ${copyOrUnzip_outputDirectory} != . ]]; then
        cd ${copyOrUnzip_originalDirectory}
    fi
} ## End of 'function copyOrUnzip'

if [[ -d "${workdir}" ]]; then
    die "The working directory ${workdir} already exist!"
fi

say "Preparing the working directory ${workdir}"
mkdir -p ${workdir}
cd ${workdir}

copyOrUnzip ${constants} .

copyOrUnzip ${ensemble} ensemble ln

copyOrUnzip ${observations} obsfiles

cp ${nml} flnml

say "Preparing 'ptopo_nml' for ${npex}x${npey} MPI decomposition"
cat > ptopo_nml <<EOF
 &ptopo
  npex=${npex}
  npey=${npey}
/
EOF

if [ "${dosplit}" = yes ]; then
    ## Splitting the observations files according to the MPI topology ${npex}x${npey}
    split_error_detected=false
    observations_files=$(ls -SLr obsfiles/*)
    mkdir obsfiles_split

    say "Split the observations files into ${npex}x${npey} parts"

    for obsfile in ${observations_files}; do
        obsFileName=${obsfile##*/}
        say "Processing the file ${obsFileName} starting at $(date)"
        SECONDS=0
        ${splitobs} -obsin ${obsfile} -obsout obsfiles_split/${obsFileName} -round-robin  \
                    -npex ${npex} -npey ${npey} -ndigits ${splitobs_ndigits}              \
                    > splitobs.${obsFileName}.listing 2>&1 || split_error_detected=true
        if [[ "${split_error_detected}" = true ]]; then
            die "Error while splitting the file '${obsfile}'" "Check the listing '${PWD}/splitobs.${obsFileName}.listing'"
        fi
        if [[ "${SECONDS}" > 60 ]]; then
            minutes=" or $((SECONDS/60)) minutes"
        else
            minutes=
        fi
        say "Completed splitting for the file ${obsFileName} at $(date) in ${SECONDS} seconds${minutes}"
    done ## End of 'for obsfile in ${observations_files}'
else ## End of 'if [ "${dosplit}" = yes ]'
    mv obsfiles obsfiles_split
fi ## End of 'else' associated to 'if [ "${dosplit}" = yes ]'


midas_program=${splitobs%/*}/midas-letkf.Abs
if [[ ! -f "${midas_program}" ]]; then
    midas_program=midas-letkf.Abs
fi

touch prepare_done_${npex}x${npey}

if [[ -v EC_ARCH ]]; then
    say "You can now launch the MIDAS program with" "midas.submit_program -workdir ${workdir} -pgm ${midas_program}"
fi
