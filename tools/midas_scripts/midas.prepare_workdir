#!/bin/bash

set -euo pipefail

arguments=$*
eval $(${CCLARGS:-cclargs} -D "" $0               \
  -ensemble  "" "" "[path to ensemble directory]" \
  -nml       "" "" "[path to namelist file]"      \
  -observations "" "" "[path to observations]"    \
  -constants "" "" "[path to constants]"          \
  -npex   "" "" "[number of MPI ranks along the X axis]" \
  -npey   "" "" "[number of MPI ranks along the Y axis]" \
  -workdir   "" "" "[output working directory]"   \
  -splitobs  "" "" "[path to the 'midas.splitobs.Abs' program]" \
  -splitobs_ndigits  "4" "4" "[number of digits for the extension when splitting observations files]" \
  ++ $arguments)

## On verifie si certains arguments sont presents

scriptName=${0##*/}

function say {
    printf "${scriptName}: ${*}\n"
} ## End of 'function say'

function die {
    say $@ >&2
    exit 1
} ## End of 'function die'

for launch_arg in ensemble nml observations constants npex npey workdir splitobs; do
    eval launch_tmp_var="\${${launch_arg}}"
    if [ -z "${launch_tmp_var}" ]; then
        die "the argument '-${launch_arg}' must be defined"
    fi
    unset launch_tmp_var
done
unset launch_arg


function copyOrUnzip {
    if [[ $# -ne 2 ]]; then
        die "copyOrUnzip: Cannot accept other than 2 arguments.  Here: 'copyOrUnzip ${*}'"
    fi

    local copyOrUnzip_input copyOrUnzip_outputDirectory copyOrUnzip_orginalDirectory
    copyOrUnzip_input=${1}
    copyOrUnzip_outputDirectory=${2}
    copyOrUnzip_originalDirectory=${PWD}

    if [[ ${copyOrUnzip_outputDirectory} != . ]]; then
        mkdir ${copyOrUnzip_outputDirectory}
        cd ${copyOrUnzip_outputDirectory}
    fi

    if [[ -d "${copyOrUnzip_input}" ]]; then
        say "Copying files from ${copyOrUnzip_input}"
        cp -rL ${copyOrUnzip_input}/* .
    elif [[ -f "${copyOrUnzip_input}" ]]; then
        if [[ "${copyOrUnzip_input}" = *.ca ]]; then
            say "Extracting files from ${copyOrUnzip_input}"
            cmcarc -f ${copyOrUnzip_input} -x
        else
            die "copyOrUnzip: If the first argument is a file, it must be a '.ca' file (cmcarc format)\n\tGot ${copyOrUnzip_input}"
        fi
    fi

    if [[ ${copyOrUnzip_outputDirectory} != . ]]; then
        cd ${copyOrUnzip_originalDirectory}
    fi
} ## End of 'function copyOrUnzip'

if [[ -d "${workdir}" ]]; then
    die "The working directory ${workdir} already exist!"
fi

mkdir ${workdir}
cd ${workdir}

copyOrUnzip ${observations} obsfiles

copyOrUnzip ${constants} .

copyOrUnzip ${ensemble} .

cp ${nml} flnml

say "Preparing 'ptopo_nml' for ${npex}x${npey} MPI decomposition"
cat > ptopo_nml <<EOF
 &ptopo
  npex=${npex}
  npey=${npey}
/
EOF

## Splitting the observations files according to the MPI topology ${npex}x${npey}
observations_files=$(ls -SLr obsfiles/*)
mkdir obsfiles_splitted
for obsfile in ${observations_files}; do
    obsFileName=${obsfile##*/}
    say "Splitting the file ${obsfile} into ${npex}x${npey} parts"
    for procX in $(seq 1 ${npex}); do
        for procY in $(seq 1 ${npey}); do
            ${splitobs} -obsin ${obsfile} -obsout obsfiles_splitted/${obsFileName} -round-robin \
                        -x ${procX} -y ${procY} -npex ${npex} -npey ${npey} -ndigits ${splitobs_ndigits}
        done ## End of 'for procY in $(seq 1 ${npey})'
    done ## End of 'for procX in $(seq 1 ${npex})'
done ## End of 'for obsfile in ${observations_files}'

midas_program=${splitobs%/*}/midas-letkf.Abs

say "You can now launch the MIDAS program with"
say "\tmidas.launch_program -workdir ${workdir} -pgm ${midas_program}"
