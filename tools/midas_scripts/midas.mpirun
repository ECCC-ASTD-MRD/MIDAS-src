#!/bin/bash

## Ce script est un wrapper autour de `r.run_in_parallel` pour rassembler
## le code qui doit être exécuté avant de lancer le MPI.

set -ex

__midas_mpirun_pgm__=$1
shift
__midas_mpirun_msg__=$1
shift
__midas_mpirun_ssm__=$1
shift
__midas_mpirun_OMP_STACKSIZE__=$1
shift
## Cette variable doit inclure l'appel a 'r.run_in_parallel' comme par exemple
##     ${TASK_BIN}/r.run_in_parallel -npex 10 -npey 10
__midas_mpirun_call_program__=$@

if [ -x ${MAESTRO_BIN}/nodelogger ]; then
    __midas_mpirun_nodelogger__=${MAESTRO_BIN}/nodelogger
else
    __midas_mpirun_nodelogger__=$(which nodelogger || true)
    if [ -z "${__midas_mpirun_nodelogger__}" ]; then
	function nodelogger {
	    echo $*
	}
	__midas_mpirun_nodelogger__=nodelogger
    fi
fi

${__midas_mpirun_nodelogger__} -n ${SEQ_NODE} ${SEQ_LOOP_ARGS} -s infox -m  "Launching program ${__midas_mpirun_msg__}"
unset __midas_mpirun_msg__ __midas_mpirun_nodelogger__

export OMP_STACKSIZE=${__midas_mpirun_OMP_STACKSIZE__}
unset __midas_mpirun_OMP_STACKSIZE__

if [ "${EC_ARCH}" = rhel-8-icelake-64 ]; then
    set +x
    echo loading rpn/code-tools/20251217/env/inteloneapi-2022.1.2
    . r.load.dot rpn/code-tools/20251217/env/inteloneapi-2022.1.2
    echo loading eccc/mrd/rpn/libs/20251009-beta
    . r.load.dot eccc/mrd/rpn/libs/20251009-beta
    echo loading eccc/mrd/rpn/utils/20251009-beta/burp-tools_20.0.14-${COMP_ARCH}_${ORDENV_PLAT}
    . r.load.dot eccc/mrd/rpn/utils/20251009-beta/burp-tools_20.0.14-${COMP_ARCH}_${ORDENV_PLAT}
    set -x
elif [ "${EC_ARCH}" = rhel-9-graniterapids-64 ]; then
    set +x
    echo loading rpn/code-tools/20251217/env/inteloneapi-2025.1.0
    . r.load.dot rpn/code-tools/20251217/env/inteloneapi-2025.1.0
    echo loading eccc/mrd/rpn/libs/20251009-beta
    . r.load.dot eccc/mrd/rpn/libs/20251009-beta
    echo loading eccc/mrd/rpn/utils/20251009-beta/burp-tools_20.0.14-${COMP_ARCH}_${ORDENV_PLAT}
    . r.load.dot eccc/mrd/rpn/utils/20251009-beta/burp-tools_20.0.14-${COMP_ARCH}_${ORDENV_PLAT}
    echo loading hdf5-netcdf4
    . ssmuse-sh -d main/opt/hdf5-netcdf4/parallel/intelmpi-2025.1.0/alllib/${COMP_ARCH}/01
    set -x

    [[ -z "${I_MPI_DEBUG}"      ]] && export I_MPI_DEBUG=10
    [[ -z "${I_MPI_PIN}"        ]] && export I_MPI_PIN=1
    [[ -z "${I_MPI_PIN_DOMAIN}" ]] && export I_MPI_PIN_DOMAIN=omp

    ## If the variable 'I_MPI_PIN_PROCESSOR_EXCLUDE_LIST' is not set,
    ## this formulation respects if the variable
    ## 'I_MPI_PIN_PROCESSOR_EXCLUDE_LIST' is set to empty.
    if [[ ! -v I_MPI_PIN_PROCESSOR_EXCLUDE_LIST ]]; then
        if (( OMP_NUM_THREADS > 3 && 42%OMP_NUM_THREADS == 0 )); then
            export I_MPI_PIN_PROCESSOR_EXCLUDE_LIST=42,85,170,213
            echo "Since OMP_NUM_THREADS=${OMP_NUM_THREADS} divides 42 exactly and greater than 3,"
            echo "exclude some cores from processor list: I_MPI_PIN_PROCESSOR_EXCLUDE_LIST=${I_MPI_PIN_PROCESSOR_EXCLUDE_LIST}"
        fi ## End of 'if (( 42 % OMP_NUM_THREADS == 0 ))'
    fi ## End of 'if [[ -z "${I_MPI_PIN_PROCESSOR_EXCLUDE_LIST}" ]]'
else
    echo "midas.mpirun: The plateform 'EC_ARCH=${EC_ARCH}' is not supported (only 'rhel-8-icelake-64' and 'rhel-9-graniterapids-64' are)"
    exit 1
fi

## find 'npex' and 'npey' in '${__midas_mpirun_call_program__}'
npex=1
npey=1
set -- ${__midas_mpirun_call_program__}
while [ $# -ne 0 ]; do
    case $1 in
        -npex)
            npex=$2
            shift
            ;;
        -npey)
            npey=$2
            shift
            ;;
    esac
    shift
done

SECONDS=0
## create indiviual trace for each rank
for rank in $(seq 0 $((npex*npey-1))); do
    mkdir tmpdir_${rank}
    date +%Y%m%d:%H:%M:%S.%N > tmpdir_${rank}/touch.before.launch.${rank}
done
echo "The files 'touch.before.launch.*' have been created in ${SECONDS} seconds"

cat > midas.mpi_script.sh <<EOF
#!/bin/bash

set -ex

SECONDS=0

status=0
${__midas_mpirun_pgm__} \$@ -rank_tmpdir ${PWD}/tmpdir_\${MP_CHILD} || status=1

if [ "\${status}" -ne 0 ]; then
    echo "The MPI execution aborted!"
    exit 1
fi

$(which echo) MP_CHILD=\${MP_CHILD} \$($(which date) +%Y%m%d:%H:%M:%S.%N) before erasing touch.before.launch.\${MP_CHILD}
$(which rm)   ${PWD}/tmpdir_\${MP_CHILD}/touch.before.launch.\${MP_CHILD}
$(which echo) MP_CHILD=\${MP_CHILD} \$($(which date) +%Y%m%d:%H:%M:%S.%N) after erasing touch.before.launch.\${MP_CHILD}

echo SECONDS=\${SECONDS}

EOF
chmod u+x midas.mpi_script.sh


status=0

SECONDS=0
${__midas_mpirun_call_program__} -stack unlimited -processorder -tag -nocleanup -verbose -pgm ${PWD}/midas.mpi_script.sh || status=1
echo "The whole MPI execution took ${SECONDS} seconds"

unset __midas_mpirun_call_program__ __midas_mpirun_pgm__

SECONDS=0

if [ "${status}" -ne 0 ]; then
    echo "The whole MPI execution aborted!"
    exit 1
fi

## Check if all individual MPI tiles ran without errors
abortedRanks=
for rank in $(seq 0 $((npex*npey-1))); do
    touch_file=tmpdir_${rank}/touch.before.launch.${rank}
    if [ -f "${touch_file}" ]; then
        abortedRanks="${abortedRanks} ${touch_file}"
    fi
done

if [ -n "${abortedRanks}" ]; then
    echo "Some MPI ranks aborted!"
    echo ${abortedRanks}
    echo "The execution verification took ${SECONDS} seconds"
    exit 1
fi

for rank in $(seq 0 $((npex*npey-1))); do
    rm -r tmpdir_${rank}
done

echo "The execution verification took ${SECONDS} seconds"
