#!/bin/bash

SCRIPT=`readlink -f $0`
SCRIPT_PATH=`dirname $SCRIPT`

# Ajouter des path pour l'utilisation avec appel
# direct a l'utilitaire.
export LD_LIBRARY_PATH=$SCRIPT_PATH/../lib:${LD_LIBRARY_PATH} # 
export LD_LIBRARY_PATH=$SCRIPT_PATH/../src:${LD_LIBRARY_PATH} # 

export DSQLITE_MASK_TERREMER=${DSQLITE_MASK_TERREMER:-${CMCCONST}/ade.land_sea_mask}

####
# Analyse de glace
f=$(ls -1 $CMCPROD/hubs/suites/ops/gdps/g6/gridpt/anal/sfc/*_000 | tail -n1)
export DSQLITE_MASK_GLACE_FSTD=${DSQLITE_MASK_GLACE_FSTD:-$f}

####
# Glace climatologique ?
export DSQLITE_MASK_GLACE=${DSQLITE_MASK_GLACE:-${CMCADE}/constants/ade.maskice10}

if [[ $DSQLITE_DEBUG == true ]]; then
  echo DSQLITE_MASK_TERREMER=$DSQLITE_MASK_TERREMER
  echo DSQLITE_MASK_GLACE_FSTD=$DSQLITE_MASK_GLACE_FSTD
  echo DSQLITE_MASK_GLACE=$DSQLITE_MASK_GLACE
fi



sqlite3 -init ${SCRIPT_PATH}/init_directives "${@}"
