# Machine stuff
FRONTEND=ppp6
BACKEND=underhill

REFERENCE_MACHINE=ppp5
REFERENCE_UPDATE_MACHINE=ppp5

BACKEND_DEFAULT_Q=development
BACKEND_LARGEMEMORY_Q=development
FRONTEND_DEFAULT_Q=development

BACKEND_XFER_Q=xfer
FRONTEND_XFER_Q=xfer

SEQ_DEFAULT_MACHINE=ppp6
SEQ_CONTAINER_METHOD=immediate

SEQ_JOBNAME_PREFIX=midas-

## Resources for the test '/Tests/var/Envar/gdps'
VAR_GDPS_CPUS=20x45x4
## Resources for the test '/Tests/letkf/glb_xc40'
LETKF_GLBXC40_CPUS=24x49x2

## Set this variable to '9' if you want to avoid running the 'check'
## task for each test
CHECK_RESULTS_CATCHUP=2

## Set this variable to '9' if you want to avoid running the 'clean'
## task for each test
CLEAN_UNITTEST_CATCHUP=2

## Set this variable for the number of minimization iterations
## 'NITERMAX' for EnVar in the tests '/Tests/var/EnVar/gdps' and
## '/Tests/var/EnVar/hrdps'.
VAR_NITERMAX=70

## Set this variable to the number of OpenMP threads needed in the
## task '/Tests/letkf/glb_15km/UnitTest/run'
LETKF_GLB15KM_NUM_THREADS=2

## Set this variable to the memory needed in the task
## '/Tests/letkf/glb_15km/UnitTest/run'
LETKF_GLB15KM_MEMORY=11G

## Set this variable to the MPI topology needed in the task
## '/Tests/letkf/glb_10km/UnitTest/run'
## The two current options are "11x52" and "48x52" for which the appropriate
## 'nml', 'inputs*.ca' and 'results.ca' files will be selected.
LETKF_GLB10KM_MPITOPOLOGY=11x52
##LETKF_GLB10KM_MPITOPOLOGY=48x52

## Set this variable to '9' if you want to avoid running the test
## '/Tests/letkf/glb_10km'.
LETKF_GLB10KM_CATCHUP=2
