
args=${*}

## The user can specify arguments using
##   maestro -n ${SEQ_NODE} -d ${SEQ_DATE} -s submit -o -args 'UnitTest_stop_for_interactive_work=yes'
if [ -n "${args}" ]; then
    for arg in ${args}; do
        if [[ "${arg}" = UnitTest_stop_for_interactive_work=* ]]; then
            eval ${arg}
        fi
    done
fi

cp ${UnitTest_run_namelist} flnml
cp ${TASK_BIN}/pgm .
ln -s ${TASK_INPUT}/inputs/* .

cat > localFilesNotToErase <<EOF
localFilesNotToErase
flnml
pgm
obsfiles_split
EOF
for target in ${TASK_INPUT}/inputs/*; do
    echo $(basename ${target}) >> localFilesNotToErase
done

mkdir obsfiles_split
if [ -L obs -o -d obs ]; then
    sscp obs/* obsfiles_split
    if [ -L obs ]; then
        rm obs
    else
        rm -r obs
    fi
else
    obsfiles=$(ls obsfiles_*/obs*_*_* burpfiles_*/brp*_*_* sqlfiles_*/obs*_*_* 2>/dev/null || true)
    if [ -n "${obsfiles}" ]; then
        sscp ${obsfiles} obsfiles_split
    fi
fi

echo load_env.dot >> localFilesNotToErase

cat >> load_env.dot <<EOF

export AFSISIO=/home/smco502
export CMCCONST=/home/smco502/datafiles/constants
export TMG_ON=YES
export OMP_STACKSIZE=4G
export OMP_NUM_THREADS=${OMP_NUM_THREADS}

export SEQ_NPEX=${SEQ_NPEX}
export SEQ_NPEY=${SEQ_NPEY}

export FOR_DUMP_CORE_FILE=${UnitTest_run_dump_core}
EOF

echo                    >> load_env.dot
## for non-interactive use, we want to unset the 'set -x' done in the job
echo "tty -s || set +x" >> load_env.dot
if [[ "${ORDENV_PLAT}" = sles-*xc50 ]]; then
    #export TBB_MALLOC_USE_HUGE_PAGES=1
    echo echo loading load craype-hugepages16M >> load_env.dot
    echo module load craype-hugepages16M       >> load_env.dot
    echo export FOR_DISABLE_KMP_MALLOC=0       >> load_env.dot
elif [[ "${ORDENV_PLAT}" = ubuntu-18.04* ]]; then
    echo echo loading intelpsxe-cluster-19.0.3.199 and OpenMPI 3.1.2 librairies                  >> load_env.dot
    echo . ssmuse-sh -d hpco/exp/intelpsxe-cluster-19.0.3.199                                    >> load_env.dot
    ## loading OpenMPI 3.1.2 (the binaries must be compiled with too)
    echo . ssmuse-sh -d hpco/exp/openmpi/openmpi-3.1.2--hpcx-2.2.0--ofed-4.4.2--intel-2019.0.045 >> load_env.dot
    echo . ssmuse-sh -d hpco/exp/openmpi-setup/openmpi-setup-0.2                                 >> load_env.dot
elif [ "${ORDENV_PLAT}" = rhel-8-icelake-64 ]; then
    echo echo loading rpn/code-tools/20250826/env/inteloneapi-2022.1.2 >> load_env.dot
    echo . r.load.dot rpn/code-tools/20250826/env/inteloneapi-2022.1.2 >> load_env.dot
    echo echo loading eccc/mrd/rpn/libs/20250909-beta >> load_env.dot
    echo . r.load.dot eccc/mrd/rpn/libs/20250909-beta >> load_env.dot
    echo echo loading eccc/mrd/rpn/utils/20250909-beta >> load_env.dot
    echo . r.load.dot eccc/mrd/rpn/utils/20250909-beta >> load_env.dot
else
    echo "The plateform ORDENV_PLAT=${ORDENV_PLAT} is not supported"
    exit 1
fi
## for non-interactive use, we want to set back 'set -x'
echo "tty -s || set -x" >> load_env.dot
echo                    >> load_env.dot

if [ -n "${UnitTest_run_environment_variables}" ]; then
    for __envvar__ in ${UnitTest_run_environment_variables}; do
        echo export ${__envvar__} >> load_env.dot
    done
    echo >> load_env.dot
fi

cat >> load_env.dot <<EOF
ulimit -c unlimited

## If you want to use DDT:
## . ssmuse-sh -x main/opt/forge/23.1

EOF

echo ptopo_nml >> localFilesNotToErase

cat << EOF > ptopo_nml
 &ptopo
  npex=${SEQ_NPEX}
  npey=${SEQ_NPEY}
/
EOF

pgmpath=$(readlink -f ${TASK_BIN}/pgm)
${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s infox -m "Launching ${pgmpath##*/} at ${pgmpath}"

if [ -L ${TASK_BIN}/mpiscript ]; then
    echo mpiscript >> localFilesNotToErase
    cp ${TASK_BIN}/mpiscript ./mpiscript
    chmod +x mpiscript
    LAUNCH_CMD=./mpiscript
else
    LAUNCH_CMD=./launch_cmd
fi

echo export LAUNCH_CMD=${LAUNCH_CMD} >> load_env.dot
echo export VTUNE_SSM=${UnitTest_run_vtune_ssm} >> load_env.dot
echo export LAUNCH_PROGRAM_SOURCE_DIRS=${MIDAS_toplevel}/src/modules:${MIDAS_toplevel}/src/programs >> load_env.dot

localFilesNotToErase="${localFilesNotToErase} launch_program.sh launch_cmd listing"
cat >> localFilesNotToErase <<EOF
isFileInList.sh
launch_program.sh
launch_cmd
listing
EOF

. ./load_env.dot

ln -s ${TASK_BIN}/isFileInList.sh isFileInList.sh
ln -s ${TASK_BIN}/launch_program.sh launch_program.sh

vtune_args=
if [ -n "${UnitTest_run_vtune_mode}" ]; then
    vtune_args=--vtune=${UnitTest_run_vtune_mode}
fi

run_pgm_args=
if [ -n "${UnitTest_run_pgm_args}" ]; then
    run_pgm_args="--args ${UnitTest_run_pgm_args}"
fi

status=0
./launch_program.sh ${vtune_args} --npex ${SEQ_NPEX} --npey ${SEQ_NPEY} ${run_pgm_args} ./pgm 1> listing 2>&1 || status=1
cat listing

if [ "${UnitTest_stop_for_interactive_work}" = yes ]; then
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "We stop here to let you continue to work interactively."
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "You can use:"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "    ${SEQ_EXP_HOME}/modules/UnitTest/scripts/launch_interactive.sh -exp ${SEQ_EXP_HOME} -node ${SEQ_NODE} -date ${SEQ_DATE}"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "to launch an interactive job."
    if [ "${status}" -ne 0 ]; then
        ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "The program aborted!"
        exit 1
    fi
    SEQ_XFER=stop
elif [ -n "${UnitTest_run_vtune_mode}" ]; then
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "We stop here to let you inspect the 'vtune' profiling data with the commands:"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "   . ssmuse-sh -x ${UnitTest_run_vtune_ssm}"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "   cd ${TASK_WORK}"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "   vtune-gui ./vtune.*"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "Select only one of the 'vtune.*' directories"
    SEQ_XFER=stop
else
    if [ "${status}" -ne 0 ]; then
        echo "launch_program.sh did end with an error!" >&2
        exit 1
    fi

    RUNTIME=$(grep --text '^RUNTIME=[0-9.]\+$' listing | cut -d= -f2)

    ## If we will not check the runtime, then issue the message now
    if [ -z "${UnitTest_maximum_execution_time}" ]; then
        ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s infox -m "The runtime was ${RUNTIME} seconds."
    fi

    if (( $(echo "${RUNTIME} < 3" | bc -l) )); then
        ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "The runtime was ${RUNTIME} seconds which is really short."
        exit 1
    fi

    ## remove inputs
    for file in ${TASK_INPUT}/inputs/*; do
        bfile=$(basename ${file})
        ## habituellement, les fichiers 'brp', 'sql' ou 'sqlfiles' sont mis a jour alors on ne les efface pas pour les garder
        if [[ "${bfile}" == brp* || "${bfile}" == sql* || "${bfile}" == obsfiles* ]]; then
            if [ -f "${file}" ]; then
                continue
            fi
        fi
        rm -r ${bfile}
    done

    ## remove other files created by the execution
    rm -f flnml pgm ptopo_nml run.sh mpiscript VAR3D_STATUS.dot isFileInList.sh
    rm -f load_env.dot launch_program.sh launch_cmd listing localFilesNotToErase
    rm -r mpitmpdir
    [ -d obs ] && rm -r obs
    [ -d obsfiles_split ] && rm -r obsfiles_split
    [ -d obsBeforeThinning ] && rm -r obsBeforeThinning

    ## put all the rest in 'output'
    mv * ${TASK_OUTPUT}

    ## Check runtime
    if [ -n "${UnitTest_maximum_execution_time}" ]; then
        function parse_time {
            set -e
            __parse_time__=$1
            if [[ "${__parse_time__}" == *:*:* ]]; then
                __parse_time_seconds__=$(echo ${__parse_time__} | awk -F: '{print 3600*$1 + 60*$2 + $3}')
            elif [[ "${__parse_time__}" == *:* ]]; then
                __parse_time_seconds__=$(echo ${__parse_time__} | awk -F: '{print 60*$1 + $2}')
            else
                __parse_time_seconds__=${__parse_time__}
            fi
            unset __parse_time__

            echo ${__parse_time_seconds__}
            unset __parse_time_seconds__
        }

        max_seconds=$(parse_time ${UnitTest_maximum_execution_time})

        if (( $(echo "${RUNTIME} > ${max_seconds}" | bc -l) )); then
            max_seconds=$(printf "%.2f" ${max_seconds})
            ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "The runtime was ${RUNTIME} seconds which is greater than the maximum allowed ${max_seconds}"
            if [ "${UnitTest_abort_when_over_maximum_exection_time}" = abort ]; then
                exit 1
            fi
        else
            ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s infox -m "The runtime was ${RUNTIME} seconds."
        fi
    fi ## Fin du 'if [ -n "${UnitTest_maximum_execution_time}" ]'

    if [ "${UnitTest_run_relaunch}" = run ]; then
        SEQ_XFER=stop
        maestro -s submit -n ${SEQ_NODE} -d ${SEQ_DATE} -f stop
    elif [ "${UnitTest_run_relaunch}" != check -a "${UnitTest_run_relaunch}" != no ]; then
        echo "The variable 'UnitTest_run_relaunch' can only be equal to 'run', 'check' or 'no' and not '${UnitTest_run_relaunch}'."
        exit 1
    fi ## Fin du 'if [ "${UnitTest_run_relaunch}" = run ]'

fi ## Fin du 'else' associe au 'if [ "${UnitTest_stop_for_interactive_work}" = yes ]; then'
