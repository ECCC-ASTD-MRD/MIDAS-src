
args=${*}

## The user can specify arguments using
##   maestro -n ${SEQ_NODE} -d ${SEQ_DATE} -s submit -o -args 'UnitTest_stop_for_interactive_work=yes'
if [ -n "${args}" ]; then
    for arg in ${args}; do
        if [[ "${arg}" = UnitTest_stop_for_interactive_work=* ]]; then
            eval ${arg}
        fi
    done
fi

echo "cat <<EOF " > gen_nml.dot
cat ${UnitTest_run_namelist} >> gen_nml.dot
printf "\nEOF" >> gen_nml.dot
. ./gen_nml.dot > flnml

cp ${TASK_BIN}/pgm .
ln -s ${TASK_INPUT}/inputs/* .

cat > localFilesNotToErase <<EOF
localFilesNotToErase
flnml
pgm
obsfiles_split
EOF
for target in ${TASK_INPUT}/inputs/*; do
    echo $(basename ${target}) >> localFilesNotToErase
done

mkdir obsfiles_split
if [ -L obs -o -d obs ]; then
    sscp obs/* obsfiles_split
    if [ -L obs ]; then
        rm obs
    else
        rm -r obs
    fi
else
    obsfiles=$(ls obsfiles_*/obs*_*_* burpfiles_*/brp*_*_* sqlfiles_*/obs*_*_* 2>/dev/null || true)
    if [ -n "${obsfiles}" ]; then
        sscp ${obsfiles} obsfiles_split
    fi
fi

echo load_env.dot >> localFilesNotToErase

cat >> load_env.dot <<EOF
export AFSISIO=/home/smco502
export CMCCONST=/home/smco502/datafiles/constants
export TMG_ON=YES
export OMP_STACKSIZE=4G
export OMP_NUM_THREADS=${OMP_NUM_THREADS}
export FOR_DUMP_CORE_FILE=${UnitTest_run_dump_core}

export SEQ_NPEX=${SEQ_NPEX}
export SEQ_NPEY=${SEQ_NPEY}

EOF

for app_variable in $(env | grep '^APP_'); do
    echo "export ${app_variable}" >> load_env.dot
done
echo                    >> load_env.dot
## for non-interactive use, we want to unset the 'set -x' done in the job
echo "tty -s || set +x" >> load_env.dot

if [ "${ORDENV_PLAT}" = rhel-9-graniterapids-64 ]; then
    if [[ "${UnitTest_compiler}" == *'GNU'* ]]; then
        echo echo ... loading gnu 15.2.0 compiler >> load_env.dot
        echo . r.load.dot rpn/code-tools/20260219/env/exp/gnu-15.2.0 >> load_env.dot
    else
        ## Intel compiler
        echo echo loading rpn/code-tools/20260219/env/inteloneapi-2025.1.0  >> load_env.dot
        echo . r.load.dot rpn/code-tools/20260219/env/inteloneapi-2025.1.0  >> load_env.dot
    fi

    echo echo loading eccc/mrd/rpn/libs/20260316-beta  >> load_env.dot
    echo . r.load.dot eccc/mrd/rpn/libs/20260316-beta  >> load_env.dot
    echo echo loading eccc/mrd/rpn/utils/20260316-beta >> load_env.dot
    echo . r.load.dot eccc/mrd/rpn/utils/20260316-beta >> load_env.dot

    if [[ "${UnitTest_compiler}" == *'GNU'* ]]; then
        ## Back to original values
        echo export ORDENV_PLAT=${ORDENV_PLAT}         >> load_env.dot

        ## We need to add the path to MKL shared objects
        MKLROOT=/fs/ssm/main/opt/intelcomp/master/inteloneapi_2025.1.0_amd64-64/mkl/latest/
        echo export LD_LIBRARY_PATH=${MKLROOT}/lib/intel64:\${LD_LIBRARY_PATH} >> load_env.dot

        ## Add 'PRTE_MCA_prte_silence_shared_fs' to remove a warning from OpenMPI
        ##    The warning is
        ##         --------------------------------------------------------------------------
        ##         PRTE has detected that the head of the session directory tree (where
        ##         scratch files and shared memory backing storage will be placed)
        ##         resides on a shared file system:
        ##
        ##            Directory: ${SUITE}/maestro/suites/midas_system_tests/hub/ppp6/work/20250731000000/Tests/var/EnVar/2D_ppp/UnitTest/run/work/mpitmpdir
        ##            File system type: gpfs
        ##
        ##         For performance reasons, it is strongly recommended that the session
        ##         directory be located on a local file system. This can be controlled by
        ##         setting the system temporary directory to be used by PRTE using either
        ##         the TMPDIR envar or the "prte_tmpdir_base" MCA param.
        ##
        ##         If you need the temporary directory to be different on remote nodes
        ##         from the local one where prterun is running (e.g., when a login node is
        ##         being employed), then you can set the local temporary directory using
        ##         the "prte_local_tmpdir_base" MCA param and the one to be used on all
        ##         other nodes using the "prte_remote_tmpdir_base" param.
        ##
        ##         This is only a warning advisory and your job will continue. You can
        ##         disable this warning in the future by setting the
        ##         "prte_silence_shared_fs" MCA param to "1".
        ##         ------------------------------------------------
        echo export PRTE_MCA_prte_silence_shared_fs=1 >> load_env.dot

        echo echo ... loading hdf5-netcdf4                                                           >> load_env.dot
        echo module load hdf5/gcc-15.2 netcdf/gcc-15.2 netcdf-fortran/gcc-15.2                       >> load_env.dot
    else
        echo echo ... loading hdf5-netcdf4                                                           >> load_env.dot
        echo . ssmuse-sh -d main/opt/hdf5-netcdf4/parallel/intelmpi-2025.1.0/alllib/\${COMP_ARCH}/01 >> load_env.dot

        echo 'set -x'                                                        >> load_env.dot
        echo '[[ -z "${I_MPI_DEBUG}"      ]] && export I_MPI_DEBUG=10      ' >> load_env.dot
        echo '[[ -z "${I_MPI_PIN}"        ]] && export I_MPI_PIN=1         ' >> load_env.dot
        echo '[[ -z "${I_MPI_PIN_DOMAIN}" ]] && export I_MPI_PIN_DOMAIN=omp' >> load_env.dot
        echo
        ## If the variable 'I_MPI_PIN_PROCESSOR_EXCLUDE_LIST' is not set,
        ## this formulation respects if the variable
        ## 'I_MPI_PIN_PROCESSOR_EXCLUDE_LIST' is set to empty.
        echo 'if [[ ! -v I_MPI_PIN_PROCESSOR_EXCLUDE_LIST ]]; then'                >> load_env.dot
        echo '    if (( OMP_NUM_THREADS > 3 && 42 % OMP_NUM_THREADS == 0 )); then' >> load_env.dot
        echo '        export I_MPI_PIN_PROCESSOR_EXCLUDE_LIST=42,85,170,213'       >> load_env.dot
        echo '        echo "Since OMP_NUM_THREADS=${OMP_NUM_THREADS} divides 42 exactly and greater than 3,"'                              >> load_env.dot
        echo '        echo "exclude some cores from processor list: I_MPI_PIN_PROCESSOR_EXCLUDE_LIST=${I_MPI_PIN_PROCESSOR_EXCLUDE_LIST}"' >> load_env.dot
        echo '    fi'                                                              >> load_env.dot
        echo 'fi'                                                                  >> load_env.dot
        echo 'set +x'                                                              >> load_env.dot

        ## The following definitions ensure the 'allreduce' MPI collective
        ## operation is giving the same results from run to run.  In
        ## MIDAS, we may not need this since we do not use 'mpi_allreduce'
        ## ot sum real values.
        ## JPG:
        ##         Since the change of configurations of moira's CPU to the SNC3
        ##         mode (providing 3 numa per processor instead of one), we do see
        ##         a performance improvement in GEM (15-20%) but this comes with
        ##         the caveat that results of MPI collectives are not
        ##         reproducible, unless you set the env variable I_MPI_CBWR=1 or
        ##         I_MPI_CBWR=2
        #echo export I_MPI_CBWR=1 >> load_env.dot
        #echo export I_MPI_CBWR=2 >> load_env.dot
        ##
        ## Vivian:
        ##         Since the change of configurations of moira's CPU to
        ##         the SNC3 mode, a better and more efficient control is
        ##         to export the environment variable export
        ##         I_MPI_ADJUST_ALLREDUCE=5 - this gives a timing a lot
        ##         closer a run that does not have this export. The
        ##         I_MPI_CBWR is a lot less efficient.
        ##
        ##         Dans la documentation d'Intel pour la variable d'environnement I_MPI_ADJUST_ALLREDUCE,
        ##             https://www.intel.com/content/www/us/en/docs/mpi-library/developer-reference-linux/2021-8/i-mpi-adjust-family-environment-variables.html
        ##         on a ces choix
        ##            - Recursive doubling
        ##            - Rabenseifner's
        ##            - Reduce + Bcast
        ##            - Topology aware Reduce + Bcast
        ##            - Binomial gather + scatter
        ##            - Topology aware binominal gather + scatter
        ##            - Shumilin's ring
        ##            - Ring
        ##            - Knomial
        ##            - Topology aware SHM-based flat
        ##            - Topology aware SHM-based Knomial
        ##            - Topology aware SHM-based Knary
        ##         ou 1 à 9 nous donne bit-réproducibilité pour chaque run
        ##         tandis que 10 à 12 nous donne les résultats différentes
        ##         pour chaque run. C'est probable que le défaut est un de
        ##         10,11,12 mais c'est difficile à dire car les résulatats
        ##         changeraient d'un run à l'autre. Vous pouvez essayer
        ##         chaque option pour voir vos timings et aussi vos
        ##         résultats qui sont différentes entre les algorithmes
        ##         choisis. Je teste ces options encore avec mes grosses
        ##         configurations (GDPS, HRDPS)
        #echo export I_MPI_ADJUST_ALLREDUCE=5 >> load_env.dot
    fi
else
    echo "The plateform ORDENV_PLAT=${ORDENV_PLAT} is not supported"
    exit 1
fi
## for non-interactive use, we want to set back 'set -x'
echo "tty -s || set -x" >> load_env.dot
echo                    >> load_env.dot

if [ -n "${UnitTest_run_environment_variables}" ]; then
    for __envvar__ in ${UnitTest_run_environment_variables}; do
        echo export ${__envvar__} >> load_env.dot
    done
    echo >> load_env.dot
fi

cat >> load_env.dot <<EOF
ulimit -c unlimited

## If you want to use DDT:
## . ssmuse-sh -x main/opt/forge/23.1

EOF

echo ptopo_nml >> localFilesNotToErase

cat << EOF > ptopo_nml
 &ptopo
  npex=${SEQ_NPEX}
  npey=${SEQ_NPEY}
/
EOF

pgmpath=$(readlink -f ${TASK_BIN}/pgm)
${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s infox -m "Launching ${pgmpath##*/} at ${pgmpath}"

if [ -L ${TASK_BIN}/mpiscript ]; then
    echo mpiscript >> localFilesNotToErase
    cp ${TASK_BIN}/mpiscript ./mpiscript
    chmod +x mpiscript
    LAUNCH_CMD=./mpiscript
else
    LAUNCH_CMD=./launch_cmd
fi

echo export LAUNCH_CMD=${LAUNCH_CMD} >> load_env.dot
echo export VTUNE_SSM=${UnitTest_run_vtune_ssm} >> load_env.dot
echo export LAUNCH_PROGRAM_SOURCE_DIRS=${MIDAS_toplevel}/src/modules:${MIDAS_toplevel}/src/programs >> load_env.dot

localFilesNotToErase="${localFilesNotToErase} launch_program.sh launch_cmd listing"
cat >> localFilesNotToErase <<EOF
isFileInList.sh
launch_program.sh
launch_cmd
listing
EOF

. ./load_env.dot

ln -s ${TASK_BIN}/isFileInList.sh isFileInList.sh
ln -s ${TASK_BIN}/launch_program.sh launch_program.sh

vtune_args=
if [ -n "${UnitTest_run_vtune_mode}" ]; then
    vtune_args=--vtune=${UnitTest_run_vtune_mode}
fi

run_pgm_args=
if [ -n "${UnitTest_run_pgm_args}" ]; then
    run_pgm_args="--args ${UnitTest_run_pgm_args}"
fi

status=0
./launch_program.sh ${vtune_args} --npex ${SEQ_NPEX} --npey ${SEQ_NPEY} ${run_pgm_args} ./pgm 1> listing 2>&1 || status=1
listingSize=$(stat --format="%s" listing)
tenGigabytes=$((1024*1024*1024*10))
if (( listingSize < tenGigabytes )); then
    cat listing
else
    echo "The listing has a size bigger than 10GB.  We avoid to list it here.  You can find it in the working directory."
fi

if [ "${UnitTest_stop_for_interactive_work}" = yes ]; then
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "We stop here to let you continue to work interactively."
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "You can use:"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "    ${SEQ_EXP_HOME}/modules/UnitTest/scripts/launch_interactive.sh -exp ${SEQ_EXP_HOME} -node ${SEQ_NODE} -date ${SEQ_DATE}"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "to launch an interactive job."
    if [ "${status}" -ne 0 ]; then
        ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "The program aborted!"
        exit 1
    fi
    SEQ_XFER=stop
elif [ -n "${UnitTest_run_vtune_mode}" ]; then
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "We stop here to let you inspect the 'vtune' profiling data with the commands:"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "   . ssmuse-sh -x ${UnitTest_run_vtune_ssm}"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "   cd ${TASK_WORK}"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "   vtune-gui ./vtune.*"
    ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "Select only one of the 'vtune.*' directories"
    SEQ_XFER=stop
else
    if [ "${status}" -ne 0 ]; then
        echo "launch_program.sh did end with an error!" >&2
        exit 1
    fi

    RUNTIME=$(grep --text '^RUNTIME=[0-9.]\+$' listing | cut -d= -f2)

    if (( $(echo "${RUNTIME} < 3" | bc -l) )); then
        ${MAESTRO_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "The runtime was ${RUNTIME} seconds which is really short."
        exit 1
    fi

    ## remove inputs
    for file in ${TASK_INPUT}/inputs/*; do
        bfile=$(basename ${file})
        ## habituellement, les fichiers 'brp', 'sql' ou 'sqlfiles' sont mis a jour alors on ne les efface pas pour les garder
        if [[ "${bfile}" == brp* || "${bfile}" == sql* || "${bfile}" == obsfiles* ]]; then
            if [ -f "${file}" ]; then
                continue
            fi
        fi
        rm -r ${bfile}
    done

    ## remove other files created by the execution
    rm -f flnml pgm ptopo_nml run.sh mpiscript VAR3D_STATUS.dot isFileInList.sh
    rm -f load_env.dot launch_program.sh launch_cmd localFilesNotToErase
    rm -r mpitmpdir
    [ -d obs               ] && rm -r obs
    [ -d obsfiles_split    ] && rm -r obsfiles_split
    [ -d obsBeforeThinning ] && rm -r obsBeforeThinning

    ## We hide temporarily the listing because we don't need it in '${TASK_OUTPUT}'
    mv listing .listing

    ## put all the rest in 'output' (except .listing)
    mv * ${TASK_OUTPUT}

    ## Move back the listing to its original name after results have been moved to '${TASK_OUTPUT}'
    mv .listing listing

    ## Check runtime only if the binary has been compiled in 'release' mode
    if [[ "${UnitTest_compilation_mode}" =~ Release ]]; then
        ## First, query the file to find the expected execution time and its standard deviation statistics
        test_name=$(echo ${SEQ_CONTAINER%%/UnitTest})
        test_name_regex=$(echo ${test_name} | sed 's|/|\\/|g')
        mean_execution_time=$(awk "/^${test_name_regex}[[:blank:]]/ {print \$2}" ${TASK_INPUT}/exec_times_dict)
        if [[ -n "${mean_execution_time}" ]]; then
            ## First check if the deviation from the mean is greater than 15 seconds
            ## We cannot expect timings that stable under 15 seconds
            deviation_from_mean=$(echo "${RUNTIME}-${mean_execution_time} > 15" | bc -l)
            if (( deviation_from_mean )); then
                stddev_execution_time=$(awk "/^${test_name_regex}[[:blank:]]/ {print \$3}" ${TASK_INPUT}/exec_times_dict)

                if [[ -n "${stddev_execution_time}" ]]; then
                    ## Check if the deviation from the mean is greater than 2
                    ## times the standard deviation which represents 2.5% of cases.
                    did_deviate_from_mean=$(echo "(${RUNTIME}-${mean_execution_time})/${stddev_execution_time} > 2" | bc -l)

                    if (( did_deviate_from_mean )); then
                        ${SEQ_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "The runtime was ${RUNTIME} seconds which is greater than 2 times the standard deviation from the mean (mean=${mean_execution_time}, stddev=${stddev_execution_time})"

                        if [ "${UnitTest_abort_when_over_maximum_execution_time}" = abort ]; then
                            exit 1
                        fi
                    fi
                else
                    ## When the standard deviation is not known, report if the difference is greater than 15 seconds
                    max_seconds=$(printf "%.2f" $(echo "${mean_execution_time} + 15" | bc -l))
                    ${SEQ_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "The runtime was ${RUNTIME} seconds which is greater than the maximum allowed ${max_seconds}"

                    if [ "${UnitTest_abort_when_over_maximum_execution_time}" = abort ]; then
                        exit 1
                    fi
                fi ## End of 'else' associated to 'if [[ -n "${stddev_execution_time}" ]]; then'
            fi ## End of 'if (( did_deviate_from_mean )); then'
        else
            ${SEQ_BIN}/nodelogger -n ${SEQ_NODE} -s info -m "Could not find a reference execution time in the file ${UnitTest_execution_times_dictionnary} for the test ${test_name}"
            if [ "${UnitTest_abort_when_over_maximum_execution_time}" = abort ]; then
                exit 1
            fi
        fi

        if (( ! did_deviate_from_mean )); then
            ${SEQ_BIN}/nodelogger -n ${SEQ_NODE} -s infox -m "The runtime was ${RUNTIME} seconds."
        fi
    else
        ${SEQ_BIN}/nodelogger -n ${SEQ_NODE} -s infox -m "The runtime was ${RUNTIME} seconds."
    fi ## End of 'else' associated to 'if [[ "${UnitTest_compilation_mode}" =~ Release ]]'

    if [ "${UnitTest_run_relaunch}" = run ]; then
        SEQ_XFER=stop
        maestro -s submit -n ${SEQ_NODE} -d ${SEQ_DATE} -f stop
    elif [ "${UnitTest_run_relaunch}" != check -a "${UnitTest_run_relaunch}" != no ]; then
        echo "The variable 'UnitTest_run_relaunch' can only be equal to 'run', 'check' or 'no' and not '${UnitTest_run_relaunch}'."
        exit 1
    fi ## Fin du 'if [ "${UnitTest_run_relaunch}" = run ]'

fi ## Fin du 'else' associe au 'if [ "${UnitTest_stop_for_interactive_work}" = yes ]; then'
